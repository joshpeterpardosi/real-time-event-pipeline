{
  "title": "Pipeline Health",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Throughput (txns/min)",
      "type": "timeseries",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ingested_at) AS time, count() AS value FROM transactions GROUP BY time ORDER BY time",
          "format": 1
        }
      ]
    },
    {
      "id": 2,
      "title": "Fraud Flag Rate",
      "type": "timeseries",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ingested_at) AS time, avg(is_fraud) AS value FROM transactions GROUP BY time ORDER BY time",
          "format": 1
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingestion Latency (avg, s)",
      "type": "timeseries",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ingested_at) AS time, avg(dateDiff('second', parseDateTimeBestEffort(event_timestamp), ingested_at)) AS value FROM transactions GROUP BY time ORDER BY time",
          "format": 1
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
